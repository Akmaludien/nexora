DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexora"
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Force Secure cookies in production (also auto-detected from https:// and
# x-forwarded-proto=https). Set to "true" behind TLS termination.
COOKIE_SECURE="true"
# Seed owner credentials. In production (NODE_ENV=production or
# SEED_STRICT=true) both values are required and must differ from the demo
# defaults; the seed refuses to run otherwise.
SEED_OWNER_EMAIL="architect@nexora.local"
SEED_OWNER_PASSWORD="replace-with-a-strong-seed-password"
AI_PROVIDER="mock"
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
# Shared secret for Vinyasa ↔ Nexora server-to-server integration.
# Vinyasa must set the SAME value in its own NEXORA_INTEGRATION_TOKEN and send
# it as a Bearer token. Leave empty to disable programmatic (non-session) access.
NEXORA_INTEGRATION_TOKEN=""

# Optional token for the read-only stdio MCP server (npm run mcp). When set,
# every MCP tool call must include a matching `token` argument. Leave empty to
# run the MCP server in local trust mode (development only).
NEXORA_MCP_TOKEN=""
